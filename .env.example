# Copie para .env e preencha. NUNCA faça commit do .env de verdade.

# ── Obrigatórias ──
# LLM decisor + transcrição de áudio (Whisper) — https://console.groq.com
GROQ_API_KEY=
# Supabase/Postgres: sessão do WhatsApp, estado das conversas e busca vetorial (pgvector)
DATABASE_URL=

# ── Recomendadas ──
# Resposta em áudio (TTS) e embeddings da base de conhecimento — https://aistudio.google.com
GEMINI_API_KEY=
# Endereço público do app (usado no link do QR Code)
PUBLIC_URL=https://seu-app.exemplo.com

# ── Opcionais ──
# Modelo do Groq (padrão: llama-3.3-70b-versatile)
GROQ_MODEL=
# Modelo de transcrição (padrão: whisper-large-v3-turbo)
GROQ_WHISPER_MODEL=
# Liga o endpoint /api/metricas (sem ele o endpoint fica desligado)
METRICAS_TOKEN=
# Fallback de busca de unidades de saúde
GOOGLE_PLACES_API_KEY=
# Caminho alternativo para a base de unidades (padrão: dados/unidades_saude.json)
UNIDADES_JSON=
# Porta do servidor (padrão: 3000)
PORT=
