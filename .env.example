# Copie para .env e preencha. Veja a tabela "Variáveis de ambiente" no README.

# Obrigatórias
# LLM decisor e transcrição de áudio (grátis em https://console.groq.com/keys)
GROQ_API_KEY=
# Supabase/Postgres: sessão, estado e busca vetorial
DATABASE_URL=

# Recomendadas
# Resposta em áudio e embeddings da base (grátis em https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Endereço público do servidor (usado no link do QR Code)
PUBLIC_URL=http://localhost:3000

# Opcionais
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# Liga o /api/metricas
# METRICAS_TOKEN=
# Reserva na busca de unidades de saúde
# GOOGLE_PLACES_API_KEY=
# Outro arquivo de unidades de saúde (padrão: dados/unidades_saude.json)
# UNIDADES_JSON=
# PORT=3000
